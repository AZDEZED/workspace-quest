function normalize_(v){return String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase().replace(/\s+/g,' ');}
function person_(p){
 if(!p||!BANK.classes[p.classe])throw new Error('Classe invalide');
 const nom=String(p.surname||'').trim().slice(0,80),prenom=String(p.name||'').trim().slice(0,80);
 if(nom.length<2||prenom.length<2)throw new Error('Nom et prénom requis');
 const raw=p.classe+'|'+normalize_(nom)+'|'+normalize_(prenom);
 const key=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,raw,Utilities.Charset.UTF_8).map(b=>('0'+(b&255).toString(16)).slice(-2)).join('').slice(0,24);
 return {id:key,nom:clean_(nom),prenom:clean_(prenom),classe:p.classe,label:BANK.classes[p.classe].label};
}
function clean_(s){s=String(s||'').replace(/[\u0000-\u001f]/g,' ').slice(0,250);return /^[=+@-]/.test(s)?"'"+s:s;}
function rows_(s){return s.getLastRow()>1?s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).getValues():[];}
function upsert_(s,key,row){const found=s.getLastRow()>1?s.getRange(2,1,s.getLastRow()-1,1).createTextFinder(key).matchEntireCell(true).findNext():null;s.getRange(found?found.getRow():s.getLastRow()+1,1,1,row.length).setValues([row]);}
function same_(a,b){return Array.isArray(a)&&a.length===b.length&&new Set(a).size===a.length&&a.every(v=>b.includes(v));}
function exists_(sheet,id,col){return sheet.getLastRow()>1&&!!sheet.getRange(2,col||2,sheet.getLastRow()-1,1).createTextFinder(id).matchEntireCell(true).findNext();}
function record_(p){
 if(!p||!/^[-\w]{16,80}$/.test(p.id||'')||!/^[-\w]{16,80}$/.test(p.sessionId||''))throw new Error('Événement invalide');
 if(!['session','profile','module','quiz','check','declare','heartbeat'].includes(p.type))throw new Error('Type invalide');
 const who=person_(p.student),ss=SpreadsheetApp.openById(SHEET_ID),journal=ss.getSheetByName('Journal');
 if(exists_(journal,p.id,2))return {ok:true,id:p.id};
 const now=new Date(),q=Number.isInteger(p.question)?BANK.questions[p.question]:null;
 const answers=p.answers&&typeof p.answers==='object'?p.answers:{};
 const selected=q&&Array.isArray(answers[p.question])?answers[p.question].filter(v=>Number.isInteger(v)&&v>=0&&v<4):[];
 const correct=q?same_(selected,q.a):null;
 const prior=rows_(journal).filter(r=>r[2]===who.id&&r[6]===p.sessionId);
 const first=prior.length?new Date(prior[0][0]):now;
 const seconds=Math.max(0,Math.min(Number(p.activeSeconds)||0,Math.max(0,(now-first)/1000)+120,86400));
 const mod=BANK.mods.find(m=>m.id===p.moduleId);
 journal.appendRow([now,p.id,who.id,who.nom,who.prenom,who.label,p.sessionId,p.type,mod?mod.id:'home',Math.round(seconds/6)/10,q?p.question:'',JSON.stringify(selected),q?correct:'']);
 const modules=ss.getSheetByName('Modules'),hist=rows_(journal).filter(r=>r[2]===who.id);
 const won=new Set(hist.filter(r=>r[12]===true).map(r=>Number(r[10])));
 if(mod){
  const key=who.id+':'+mod.id,old=rows_(modules).find(r=>r[0]===key);
  const checks=p.checks&&p.checks[mod.id]||{};
  const count=mod.steps.filter((_,i)=>checks[i]===true).length;
  const declared=!!(old&&old[8]==='Oui'||p.declared&&p.declared[mod.id]===true&&count===mod.steps.length);
  const num=BANK.questions.reduce((n,q,i)=>n+(q.m===mod.id&&won.has(i)?1:0),0);
  upsert_(modules,key,[key,who.nom,who.prenom,who.label,mod.title,now,count,mod.steps.length,declared?'Oui':'Non',num,BANK.questions.filter(q=>q.m===mod.id).length]);
 }
 refresh_(ss,who);
 CacheService.getScriptCache().put(p.id,'1',21600);
 return {ok:true,id:p.id};
}
function refresh_(ss,who){
 const hist=rows_(ss.getSheetByName('Journal')).filter(r=>r[2]===who.id),mods=rows_(ss.getSheetByName('Modules')).filter(r=>String(r[0]).startsWith(who.id+':')),vals=rows_(ss.getSheetByName('Validations')).filter(r=>r[2]===who.id);
 const sessions={};hist.forEach(r=>{sessions[r[6]]=Math.max(sessions[r[6]]||0,Number(r[9])||0);});
 const dates=hist.map(r=>new Date(r[0]).getTime()).concat(vals.map(r=>new Date(r[0]).getTime()));
 const first=new Date(Math.min.apply(null,dates)),last=new Date(Math.max.apply(null,dates));
 const quiz=new Set(hist.filter(r=>r[12]===true).map(r=>Number(r[10]))).size;
 const scores=GROUPS.map(g=>{const vv=vals.filter(r=>r[6]===g.name);return vv.length?Math.max.apply(null,vv.map(r=>Number(r[7]))):'';});
 upsert_(ss.getSheetByName('Suivi'),who.id,[who.id,who.nom,who.prenom,who.label,first,last,Object.keys(sessions).length,Math.round(Object.values(sessions).reduce((a,b)=>a+b,0)*10)/10,mods.length,mods.filter(r=>r[8]==='Oui').length,quiz].concat(scores));
}
function receptionValidation(e){
 if(!e||!e.source||!e.response)throw new Error('Déclencheur Forms requis');
 const lock=LockService.getScriptLock();lock.waitLock(25000);
 try{
  const props=PropertiesService.getScriptProperties();let meta;
  GROUPS.forEach((g,i)=>{const x=JSON.parse(props.getProperty('form'+i)||'null');if(x&&x.id===e.source.getId())meta=x;});
  if(!meta)throw new Error('Formulaire inconnu');
  const rr=e.response.getItemResponses(),find=t=>{const r=rr.find(r=>r.getItem().getTitle()===t);return r?r.getResponse():'';};
  const label=find('Classe'),classe=Object.keys(BANK.classes).find(k=>BANK.classes[k].label===label);
  const who=person_({surname:find('Nom'),name:find('Prénom'),classe});
  const ss=SpreadsheetApp.openById(SHEET_ID),sheet=ss.getSheetByName('Validations'),id=e.response.getId();if(exists_(sheet,id,2))return;
  let score=0;const detail=[];
  meta.items.forEach(it=>{const q=BANK.questions[it.q],r=rr.find(r=>r.getItem().getId()===it.id),value=r?r.getResponse():[];const a=Array.isArray(value)?value:[value];const good=same_(a,q.a.map(i=>q.o[i]));if(good)score++;detail.push({q:it.q,reponse:a,correct:good});});
  sheet.appendRow([e.response.getTimestamp(),id,who.id,who.nom,who.prenom,who.label,meta.name,score,meta.items.length,JSON.stringify(detail)]);refresh_(ss,who);
 }finally{lock.releaseLock();}
}
function doPost(e){
 let result;
 try{const raw=e&&e.parameter&&e.parameter.payload;if(!raw||raw.length>18000)throw new Error('Taille invalide');const p=JSON.parse(raw);const lock=LockService.getScriptLock();lock.waitLock(25000);try{result=record_(p);}finally{lock.releaseLock();}}
 catch(err){result={ok:false,error:'Enregistrement refusé'};}
 return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);
}
function doGet(e){
 const p=e&&e.parameter||{},cb=/^[A-Za-z_$][\w$]{0,50}$/.test(p.callback||'')?p.callback:null;let result;
 if(p.action==='config')result={ok:true,forms:JSON.parse(PropertiesService.getScriptProperties().getProperty('publicConfig')||'[]')};
 else if(p.action==='ack'&&/^[-\w]{16,80}$/.test(p.id||'')){
  let ok=CacheService.getScriptCache().get(p.id)==='1';
  if(!ok)ok=exists_(SpreadsheetApp.openById(SHEET_ID).getSheetByName('Journal'),p.id,2);
  result={ok:!!ok,id:p.id};
 }else result={ok:true,service:'Workspace Quest',version:2};
 return ContentService.createTextOutput(cb?cb+'('+JSON.stringify(result)+');':JSON.stringify(result)).setMimeType(cb?ContentService.MimeType.JAVASCRIPT:ContentService.MimeType.JSON);
}
