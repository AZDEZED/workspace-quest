// Workspace Quest. Données des élèves privées dans le classeur dédié.
const SHEET_ID = 'SET_SPREADSHEET_ID';
const ORIGIN = 'https://azdezed.github.io';
const GROUPS = [
 {name:'Validation 1',mods:['gmail','outils','drive']},
 {name:'Validation 2',mods:['partage','ressources','docs']},
 {name:'Validation 3',mods:['sheets','forms','slides','agenda']},
 {name:'Validation finale',mods:['final','lexique']}
];
function installer() {
 const ss=SpreadsheetApp.openById(SHEET_ID); ss.setSpreadsheetTimeZone('Europe/Paris');
 const props=PropertiesService.getScriptProperties();
 const config=[];
 GROUPS.forEach((g,i)=>{
  const key='form'+i; let meta=JSON.parse(props.getProperty(key)||'null');
  if(!meta){
   const f=FormApp.create('Workspace Quest - '+g.name);
   meta={id:f.getId(),name:g.name,mods:g.mods,items:[]};props.setProperty(key,JSON.stringify(meta));
   f.setDescription('Choisissez les outils adaptés aux situations professionnelles et scolaires. Une réponse juste vaut 1 point. Pour les QCM, sélectionnez toutes les bonnes propositions. Votre nom, votre classe, vos réponses et la date de remise sont enregistrés pour le suivi pédagogique par A. Zeboudj. N’indiquez aucun mot de passe.');
   f.setIsQuiz(true).setCollectEmail(false).setLimitOneResponsePerUser(false).setPublishingSummary(false).setShowLinkToRespondAgain(true).setProgressBar(true);
   const nom=f.addTextItem().setTitle('Nom').setRequired(true);
   const prenom=f.addTextItem().setTitle('Prénom').setRequired(true);
   const classe=f.addListItem().setTitle('Classe').setChoiceValues(Object.values(BANK.classes).map(x=>x.label)).setRequired(true);
   BANK.questions.forEach((q,j)=>{if(!g.mods.includes(q.m))return;
    const item=q.a.length>1?f.addCheckboxItem():f.addMultipleChoiceItem();
    item.setTitle(q.q).setRequired(true).setPoints(1).setChoices(q.o.map((v,k)=>item.createChoice(v,q.a.includes(k))));
    const fb=FormApp.createFeedback().setText(q.why).build();item.setFeedbackForCorrect(fb).setFeedbackForIncorrect(fb);
    meta.items.push({id:item.getId(),q:j});
   });
   f.setConfirmationMessage('Votre validation a été enregistrée. Vous pouvez consulter votre score, puis revenir dans Workspace Quest.');
   if(f.supportsAdvancedResponderPermissions())f.setPublished(true);
   f.setAcceptingResponses(true);
   const pre=f.createResponse().withItemResponse(nom.createResponse('__NOM__')).withItemResponse(prenom.createResponse('__PRENOM__')).withItemResponse(classe.createResponse(BANK.classes['2epc'].label)).toPrefilledUrl();
   meta.prefill=pre.replace(encodeURIComponent(BANK.classes['2epc'].label),'__CLASSE__');
   meta.url=f.getPublishedUrl();meta.edit=f.getEditUrl();
   props.setProperty(key,JSON.stringify(meta));
  }
  if(!meta.url)throw new Error('Formulaire partiellement créé : '+key+'. Réparer avant de relancer.');
  if(!ScriptApp.getProjectTriggers().some(t=>t.getTriggerSourceId()===meta.id&&t.getHandlerFunction()==='receptionValidation'))ScriptApp.newTrigger('receptionValidation').forForm(meta.id).onFormSubmit().create();
  config.push({name:meta.name,mods:meta.mods,url:meta.url,prefill:meta.prefill});
  ss.getSheetByName('Ressources').getRange(i+2,3,1,2).setValues([[meta.url,meta.edit]]);
 });
 ['Suivi','Modules','Journal','Validations'].forEach(n=>{const s=ss.getSheetByName(n);if(!s.getFilter())s.getRange(1,1,s.getMaxRows(),n==='Suivi'?15:n==='Modules'?11:n==='Journal'?13:10).createFilter();});
 ss.getSheetByName('Modules').getRange('F2:F1000').setNumberFormat('dd/MM/yyyy HH:mm');
 ss.getSheetByName('Journal').getRange('A2:A1000').setNumberFormat('dd/MM/yyyy HH:mm:ss');
 ss.getSheetByName('Validations').getRange('A2:A1000').setNumberFormat('dd/MM/yyyy HH:mm');
